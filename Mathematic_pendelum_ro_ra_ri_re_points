<html>
    
<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ri_Pendel · vier Punkte</title>
<style>
  :root { color-scheme: dark; --bg:#0d0f14; --line:#d9e0ea; --red:#d4263a; --muted:#aab4c3; }
  * { box-sizing:border-box }
  html,body { margin:0; min-height:100%; background:var(--bg); color:#f4f4f0; font:16px/1.45 system-ui,sans-serif }
  main { max-width:980px; margin:auto; padding:18px }
  h1 { font-size:1.35rem; margin:0 0 5px }
  p { color:var(--muted); margin:0 0 14px }
  .stage { border:1px solid #303744; border-radius:16px; overflow:hidden; background:radial-gradient(ellipse at center,#171c26,#0d0f14 72%) }
  svg { width:100%; height:auto; display:block; touch-action:pan-y }
  .controls { display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-top:14px }
  button { border:1px solid #424b5b; background:#1b2230; color:#f4f4f0; border-radius:10px; padding:10px 14px; font:inherit }
  button:focus-visible { outline:2px solid #f2d22e; outline-offset:2px }
  .status { color:var(--muted); font-size:.9rem }
  .label { font: bold 15px system-ui,sans-serif; fill:#f4f4f0; paint-order:stroke; stroke:#0d0f14; stroke-width:4px; stroke-linejoin:round }
  .small { font:13px system-ui,sans-serif; fill:#d9e0ea }
</style>
</head>
<body>
<main>
  <h1>ri_Pendel · Punkt 1–4</h1>
  <p>Ein mathematisches Pendel schwingt vor einer roten, diagonal verlaufenden Ebene. Die Ebene ist als transparente Fläche dargestellt, die sich in der Mitte mit der Pendelbahn überschneidet.</p>
  <div class="stage">
    <svg id="scene" viewBox="0 0 800 540" role="img" aria-label="Animiertes mathematisches Pendel mit roter diagonaler Ebene und vier markierten Punkten">
      <defs>
        <linearGradient id="redPlane" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#d4263a" stop-opacity=".15"/>
          <stop offset=".5" stop-color="#ff344d" stop-opacity=".48"/>
          <stop offset="1" stop-color="#d4263a" stop-opacity=".18"/>
        </linearGradient>
        <filter id="glow"><feGaussianBlur stdDeviation="4" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
      </defs>
      <!-- reference grid -->
      <g stroke="#29313e" stroke-width="1" opacity=".65">
        <path d="M80 100H720 M80 180H720 M80 260H720 M80 340H720 M80 420H720"/>
        <path d="M160 70V470 M280 70V470 M400 70V470 M520 70V470 M640 70V470"/>
      </g>
      <!-- diagonal red plane, behind the pendulum -->
      <polygon points="150,390 300,105 665,190 515,475" fill="url(#redPlane)" stroke="#ff465a" stroke-width="2" opacity=".95"/>
      <path d="M150 390L515 475 M300 105L665 190" stroke="#ff7180" stroke-width="1.2" opacity=".75"/>
      <text x="534" y="440" class="label" fill="#ff8792">ri_rote Ebene</text>
      <text x="530" y="459" class="small">diagonal · transparent</text>
      <!-- pendulum support and arc -->
      <path d="M400 74 A220 220 0 0 1 583 416" fill="none" stroke="#697587" stroke-dasharray="5 7" stroke-width="1.5"/>
      <rect x="365" y="54" width="70" height="12" rx="5" fill="#8d98a8"/>
      <circle cx="400" cy="74" r="8" fill="#f4f4f0" stroke="#0d0f14" stroke-width="3"/>
      <text x="415" y="62" class="label">Aufhängung</text>
      <!-- dynamic pendulum -->
      <line id="string" x1="400" y1="74" x2="400" y2="300" stroke="#e5e9f0" stroke-width="3"/>
      <circle id="bob" cx="400" cy="300" r="17" fill="#f2d22e" stroke="#fff3a0" stroke-width="2" filter="url(#glow)"/>
      <!-- four marked points around crossing zone -->
      <g id="points">
        <circle cx="354" cy="205" r="7" fill="#d4263a" stroke="#ffe1e5" stroke-width="2"/>
        <text x="330" y="194" class="label">Punkt 1</text>
        <circle cx="450" cy="240" r="7" fill="#d4263a" stroke="#ffe1e5" stroke-width="2"/>
        <text x="463" y="238" class="label">Punkt 2</text>
        <circle cx="365" cy="310" r="7" fill="#d4263a" stroke="#ffe1e5" stroke-width="2"/>
        <text x="280" y="329" class="label">Punkt 3</text>
        <circle cx="490" cy="355" r="7" fill="#d4263a" stroke="#ffe1e5" stroke-width="2"/>
        <text x="503" y="360" class="label">Punkt 4</text>
      </g>
      <circle id="crossing" cx="400" cy="270" r="23" fill="none" stroke="#ff5c6e" stroke-width="2" stroke-dasharray="4 5" opacity=".9"/>
      <text x="28" y="505" class="small">Modell: ideale Punktmasse · masseloser Faden · schematische Ebenenüberschneidung</text>
    </svg>
  </div>
  <div class="controls">
    <button id="toggle" type="button">Pause</button>
    <button id="reset" type="button">Zurücksetzen</button>
    <span class="status" id="status" aria-live="polite">Schwingung läuft</span>
  </div>
</main>
<script>
(() => {
  const string = document.getElementById('string');
  const bob = document.getElementById('bob');
  const crossing = document.getElementById('crossing');
  const toggle = document.getElementById('toggle');
  const reset = document.getElementById('reset');
  const status = document.getElementById('status');
  const pivot = {x:400, y:74}, length = 250;
  let running = true, start = performance.now(), pausedAt = 0, frame;
  function draw(now) {
    if (!running) return;
    const t = (now - start) / 1000; // Ro Ra Ri Re
    const angle = 0.72 * Math.sin(t * 1.15);
    const x = pivot.x + length * Math.sin(angle);
    const y = pivot.y + length * Math.cos(angle);
    string.setAttribute('x2', x); string.setAttribute('y2', y);
    bob.setAttribute('cx', x); bob.setAttribute('cy', y);
    crossing.setAttribute('cx', 400 + 26 * Math.sin(t * 1.15));
    crossing.setAttribute('cy', 270 + 12 * Math.cos(t * 1.15));
    frame = requestAnimationFrame(draw);
  }
  toggle.addEventListener('click', () => {
    if (running) {
      running = false; cancelAnimationFrame(frame);
      pausedAt = performance.now(); toggle.textContent = 'Start'; status.textContent = 'Pendel pausiert';
    } else {
      start += performance.now() - pausedAt;
      running = true; toggle.textContent = 'Pause'; status.textContent = 'Schwingung läuft';
      frame = requestAnimationFrame(draw);
    }
  });
  reset.addEventListener('click', () => {
    start = performance.now(); pausedAt = 0;
    if (!running) { running = true; toggle.textContent = 'Pause'; status.textContent = 'Schwingung läuft'; }
    cancelAnimationFrame(frame); frame = requestAnimationFrame(draw);
  });
  frame = requestAnimationFrame(draw);
})();
</script>
</body>
</html>
 
