<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>ri_Reptilienwarnsystem</title>
<style>
  html,body{margin:0;height:100%;background:#05060a;overflow:hidden;font-family:system-ui,sans-serif;color:#e8e8ee}
  canvas{display:block;touch-action:none}
  #hud{position:fixed;left:10px;top:10px;right:10px;pointer-events:none;font-size:13px;line-height:1.45}
  #hud b{font-weight:600}
  #chips{display:flex;gap:6px;margin-top:6px}
  .chip{padding:2px 9px;border-radius:12px;font-size:12px;border:1px solid #ffffff44;opacity:.45;transition:opacity .3s}
  .chip.on{opacity:1}
  #bar{position:fixed;left:10px;right:10px;bottom:12px;height:4px;background:#ffffff18;border-radius:2px}
  #fill{height:100%;width:0;border-radius:2px;background:#fff}
  #hint{position:fixed;left:10px;bottom:24px;font-size:11px;opacity:.55}
</style>
</head>
<body>
<div id="hud">
  <div><b id="route">Quelle → Senke</b></div>
  <div id="state">–</div>
  <div id="chips">
    <span class="chip" id="c0" style="color:#ff4b52">Ro</span>
    <span class="chip" id="c1" style="color:#ffffff">Ra</span>
    <span class="chip" id="c2" style="color:#ffe14a">Ri</span>
    <span class="chip" id="c3" style="color:#4be07a">Re</span>
  </div>
  <div id="interest" style="margin-top:6px;opacity:.8"></div>
  <div style="margin-top:6px;font-size:11px;opacity:.7">Ri-Linien: Quelle→Senke · Senke→Person · Person→Ebenenfarbe · Interesse→Person</div>
</div>
<div id="hint">Ziehen = drehen · Zwei Finger / Mausrad = Zoom</div>
<div id="bar"><div id="fill"></div></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(function(){
const NAMES=['Ro','Ra','Ri','Re'];
const COLORS=[0xe0161b,0xffffff,0xffd92a,0x2fc25a];
const ROOM=5.5;
const HALF=1.5;          // halbe Kantenlänge der Ebene
const WSPEED=1.25;       // Wellengeschwindigkeit

const renderer=new THREE.WebGLRenderer({antialias:true});
renderer.setPixelRatio(Math.min(devicePixelRatio,2));
renderer.setSize(innerWidth,innerHeight);
document.body.appendChild(renderer.domElement);
const scene=new THREE.Scene();
scene.background=new THREE.Color(0x05060a);
scene.fog=new THREE.Fog(0x05060a,12,28);
const camera=new THREE.PerspectiveCamera(55,innerWidth/innerHeight,0.1,60);

scene.add(new THREE.AmbientLight(0x8890a8,0.8));
const sun=new THREE.DirectionalLight(0xffffff,0.9);sun.position.set(4,9,3);scene.add(sun);

// Raum
const floor=new THREE.Mesh(new THREE.PlaneGeometry(ROOM*2,ROOM*2),new THREE.MeshStandardMaterial({color:0x0b0d14,roughness:1}));
floor.rotation.x=-Math.PI/2;scene.add(floor);
const grid=new THREE.GridHelper(ROOM*2,20,0x2a3042,0x161a26);grid.position.y=0.01;scene.add(grid);
// Eckpfeiler des Raumes
for(const [x,z,c] of [[-1,-1,0],[1,-1,1],[1,1,2],[-1,1,3]]){
  const p=new THREE.Mesh(new THREE.BoxGeometry(0.12,3.2,0.12),new THREE.MeshStandardMaterial({color:COLORS[c],emissive:COLORS[c],emissiveIntensity:0.25}));
  p.position.set(x*ROOM,1.6,z*ROOM);scene.add(p);
}

// Person
const person=new THREE.Group();scene.add(person);
const skin=new THREE.MeshStandardMaterial({color:0x7d9a86,roughness:0.7});
const cloth=new THREE.MeshStandardMaterial({color:0x2c3b4d,roughness:0.8});
const body=new THREE.Mesh(new THREE.BoxGeometry(0.5,0.7,0.28),cloth);body.position.y=1.15;person.add(body);
const head=new THREE.Mesh(new THREE.SphereGeometry(0.19,20,16),skin);head.position.y=1.72;person.add(head);
const eyeM=new THREE.MeshBasicMaterial({color:0xffe14a});
for(const s of [-1,1]){const e=new THREE.Mesh(new THREE.SphereGeometry(0.03,8,8),eyeM);e.position.set(0.07*s,1.75,0.16);person.add(e);}
function limb(x,y,len,mat){
  const g=new THREE.Group();g.position.set(x,y,0);
  const m=new THREE.Mesh(new THREE.BoxGeometry(0.14,len,0.14),mat);m.position.y=-len/2;g.add(m);person.add(g);return g;
}
const armL=limb(-0.34,1.45,0.62,skin),armR=limb(0.34,1.45,0.62,skin);
const legL=limb(-0.13,0.8,0.8,cloth),legR=limb(0.13,0.8,0.8,cloth);

// Ebene über dem Kopf
const geo=new THREE.PlaneGeometry(HALF*2,HALF*2,72,72);
const U={
  uTime:{value:0},uPhase:{value:0},
  uSrc:{value:new THREE.Vector2()},uSnk:{value:new THREE.Vector2()},
  uR1:{value:-9},uR2:{value:-9},uAmp1:{value:0},uAmp2:{value:0},
  uType:{value:0},uJit:{value:0},uSrcPos:{value:new THREE.Vector2()}
};
const mat=new THREE.ShaderMaterial({
  uniforms:U,transparent:true,side:THREE.DoubleSide,depthWrite:false,
  vertexShader:`
    uniform float uTime,uR1,uR2,uAmp1,uAmp2,uType,uJit;
    uniform vec2 uSrc,uSnk;
    varying vec2 vUv;varying float vD;
    float wv(float x){
      if(uType<0.5) return sin(x);
      if(uType<1.5) return sin(x)+0.35*sin(3.0*x);
      if(uType<2.5) return abs(sin(x))*2.0-1.0;
      return sin(x)*cos(0.5*x);
    }
    void main(){
      vUv=uv;
      vec3 p=position;
      float f=5.5+uType*1.2;
      float d1=distance(p.xy,uSrc);
      float d2=distance(p.xy,uSnk);
      float e1=exp(-pow((d1-uR1)/0.5,2.0));
      float e2=exp(-pow((d2-uR2)/0.55,2.0));
      float disp=uAmp1*e1*wv(f*(d1-uR1))+uAmp2*e2*wv(f*(d2-uR2));
      disp+=uJit*exp(-d1*1.6)*sin(uTime*38.0+d1*4.0)*0.06;
      p.z+=disp;
      vD=disp;
      gl_Position=projectionMatrix*modelViewMatrix*vec4(p,1.0);
    }`,
  fragmentShader:`
    uniform float uTime,uPhase;
    varying vec2 vUv;varying float vD;
    vec3 pa(float i){i=mod(i,4.0);
      if(i<0.5) return vec3(0.88,0.07,0.10);
      if(i<1.5) return vec3(0.02);
      if(i<2.5) return vec3(0.97);
      return vec3(0.97);}
    vec3 pb(float i){i=mod(i,4.0);
      if(i<0.5) return vec3(0.03);
      if(i<1.5) return vec3(0.97);
      if(i<2.5) return vec3(0.98,0.85,0.10);
      return vec3(0.10,0.70,0.25);}
    void main(){
      float i=floor(uPhase);float s=smoothstep(0.0,1.0,fract(uPhase));
      vec3 a=mix(pa(i),pa(i+1.0),s);
      vec3 b=mix(pb(i),pb(i+1.0),s);
      float g=0.5+0.5*sin(vUv.x*3.0+vUv.y*2.0+uTime*0.4+vD*16.0);
      vec3 col=mix(a,b,g);
      vec2 gl=step(0.965,fract(vUv*12.0));
      col=mix(col,vec3(1.0),max(gl.x,gl.y)*0.18);
      col+=vec3(abs(vD)*5.0);
      float edge=min(min(vUv.x,1.0-vUv.x),min(vUv.y,1.0-vUv.y));
      float alpha=0.72+0.2*smoothstep(0.03,0.0,edge);
      gl_FragColor=vec4(col,alpha);
    }`
});
const plane=new THREE.Mesh(geo,mat);
plane.rotation.x=-Math.PI/2;
const planeRig=new THREE.Group();planeRig.add(plane);scene.add(planeRig);

// Eckmarker (Kinder der Ebene)
const cornerLocal=[[-HALF,HALF],[HALF,HALF],[HALF,-HALF],[-HALF,-HALF]]; // Ro,Ra,Ri,Re
function label(txt,col){
  const c=document.createElement('canvas');c.width=128;c.height=64;const x=c.getContext('2d');
  x.font='bold 44px system-ui';x.textAlign='center';x.textBaseline='middle';
  x.lineWidth=6;x.strokeStyle='#000';x.strokeText(txt,64,34);x.fillStyle=col;x.fillText(txt,64,34);
  const t=new THREE.CanvasTexture(c);
  const s=new THREE.Sprite(new THREE.SpriteMaterial({map:t,depthTest:false,transparent:true}));
  s.scale.set(0.7,0.35,1);return s;
}
const markers=cornerLocal.map((c,i)=>{
  const m=new THREE.Mesh(new THREE.SphereGeometry(0.11,16,12),new THREE.MeshBasicMaterial({color:COLORS[i]}));
  m.position.set(c[0],c[1],0.02);plane.add(m);
  const l=label(NAMES[i],'#'+COLORS[i].toString(16).padStart(6,'0'));l.position.set(c[0]*1.0,c[1]*1.0,0.35);plane.add(l);
  return m;
});
const ring=new THREE.Mesh(new THREE.RingGeometry(0.2,0.25,32),new THREE.MeshBasicMaterial({color:0xffffff,side:THREE.DoubleSide,transparent:true,opacity:0.9}));
plane.add(ring);

// eigene Interessen
const orb=new THREE.Mesh(new THREE.IcosahedronGeometry(0.22,1),new THREE.MeshBasicMaterial({color:0xffffff,wireframe:true}));
scene.add(orb);
const orbLbl=label('eigene_Interessen','#ffffff');orbLbl.scale.set(1.9,0.5,1);scene.add(orbLbl);
// Ri: Relationslinien (Quelle→Senke, Senke→Person, Person→Ebenenfarbe, Interesse→Person)
const rel=[0,1,2,3].map(()=>{
  const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.BufferAttribute(new Float32Array(6),3));
  const l=new THREE.Line(g,new THREE.LineBasicMaterial({color:0xffffff,transparent:true,opacity:0.5,depthTest:false}));
  l.frustumCulled=false;l.renderOrder=5;scene.add(l);return l;
});
function setLine(l,a,b){const p=l.geometry.attributes.position;p.setXYZ(0,a.x,a.y,a.z);p.setXYZ(1,b.x,b.y,b.z);p.needsUpdate=true;}
const orbPos=new THREE.Vector3();
function newInterest(){orbPos.set((Math.random()*2-1)*(ROOM-1),0.35+Math.random()*1.1,(Math.random()*2-1)*(ROOM-1));}
newInterest();

// Zustand
const st={
  pos:new THREE.Vector3(0,0,0),vel:new THREE.Vector3(0,0,1),heading:0,
  src:0,snk:2,state:'travel',t:0,reverseT:0,revDir:new THREE.Vector3(),
  phase:0,flinch:0,walk:0,count:0
};
function startCycle(){
  st.state='travel';st.t=0;U.uType.value=st.src;
  U.uSrc.value.set(...cornerLocal[st.src]);U.uSnk.value.set(...cornerLocal[st.snk]);
  U.uR1.value=0;U.uR2.value=-9;
}
startCycle();
function cornerWorldXZ(i){
  const v=new THREE.Vector3(cornerLocal[i][0],cornerLocal[i][1],0);plane.localToWorld(v);return v;
}
function dist(a,b){return Math.hypot(cornerLocal[a][0]-cornerLocal[b][0],cornerLocal[a][1]-cornerLocal[b][1]);}

// Kamera-Orbit
let theta=0.7,phi=0.95,rad=9.5,dragging=false,lx=0,ly=0,pinch=0;
const el=renderer.domElement;const ptrs=new Map();
el.addEventListener('pointerdown',e=>{ptrs.set(e.pointerId,e);el.setPointerCapture(e.pointerId);dragging=true;lx=e.clientX;ly=e.clientY;});
el.addEventListener('pointerup',e=>{ptrs.delete(e.pointerId);if(!ptrs.size)dragging=false;pinch=0;});
el.addEventListener('pointermove',e=>{
  if(!ptrs.has(e.pointerId))return;ptrs.set(e.pointerId,e);
  if(ptrs.size===2){const [a,b]=[...ptrs.values()];const d=Math.hypot(a.clientX-b.clientX,a.clientY-b.clientY);if(pinch)rad=Math.min(18,Math.max(4,rad*pinch/d));pinch=d;return;}
  theta-=(e.clientX-lx)*0.006;phi=Math.min(1.45,Math.max(0.25,phi-(e.clientY-ly)*0.005));lx=e.clientX;ly=e.clientY;
});
el.addEventListener('wheel',e=>{rad=Math.min(18,Math.max(4,rad+e.deltaY*0.01));},{passive:true});
addEventListener('resize',()=>{renderer.setSize(innerWidth,innerHeight);camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();});

const $=id=>document.getElementById(id);
let last=performance.now();
function tick(now){
  const dt=Math.min(0.05,(now-last)/1000);last=now;
  U.uTime.value=now/1000;

  // Phasen der Welle
  st.t+=dt;
  const D=dist(st.src,st.snk);
  let activeWave=false;
  if(st.state==='travel'){
    const r=WSPEED*st.t;U.uR1.value=r;U.uAmp1.value=Math.min(0.2,0.05+st.t*0.06);U.uJit.value=1;
    activeWave=true;
    if(r>=D){st.state='hit';st.t=0;st.flinch=1;st.count++;
      st.revDir.copy(st.vel).multiplyScalar(-1).normalize();st.reverseT=1.6;}
  }else if(st.state==='hit'){
    U.uR1.value=WSPEED*(D/WSPEED+st.t);U.uAmp1.value=Math.max(0,0.2-st.t*0.1);
    U.uR2.value=WSPEED*st.t;U.uAmp2.value=Math.max(0,0.26-st.t*0.11);U.uJit.value=0;
    activeWave=true;
    if(st.t>2.3){st.state='rest';st.t=0;}
  }else{
    U.uAmp1.value*=0.9;U.uAmp2.value*=0.9;
    if(st.t>1.0){ // bidirektional: Senke wird neue Quelle
      const old=st.snk;let n;do{n=Math.floor(Math.random()*4);}while(n===old);
      st.src=old;st.snk=n;startCycle();
    }
  }

  // Farbphase der Ebene: langsam, an Quelle gekoppelt; schneller bei Resonanz mit Interesse
  const dInt=Math.hypot(orbPos.x-st.pos.x,orbPos.z-st.pos.z);
  const resonance=1/(1+dInt*0.6);
  const target=st.src;
  let diff=((target-st.phase)%4+6)%4-2;
  st.phase+=diff*dt*(0.12+0.25*resonance);
  U.uPhase.value=((st.phase%4)+4)%4;

  // Bewegung: Interesse anziehen, Quelle meiden, nach Treffer umkehren
  const toInt=new THREE.Vector3(orbPos.x-st.pos.x,0,orbPos.z-st.pos.z).normalize();
  const srcW=cornerWorldXZ(st.src);
  const away=new THREE.Vector3(st.pos.x-srcW.x,0,st.pos.z-srcW.z);
  if(away.lengthSq()<1e-4)away.set(1,0,0);away.normalize();
  const wAvoid=activeWave&&st.state==='travel'?1.0:0.0;
  const wInt=activeWave?0.35:1.0;
  const want=new THREE.Vector3().addScaledVector(toInt,wInt).addScaledVector(away,wAvoid);
  if(st.reverseT>0){st.reverseT-=dt;want.copy(st.revDir).multiplyScalar(1.5);}
  if(want.lengthSq()<1e-4)want.copy(toInt);want.normalize();
  const speed=st.reverseT>0?2.1:(activeWave?1.7:1.1);
  st.vel.lerp(want,Math.min(1,dt*(st.reverseT>0?7:2.4))).normalize();
  st.pos.addScaledVector(st.vel,speed*dt);
  // Raumgrenzen: abprallen
  for(const ax of ['x','z']){
    if(Math.abs(st.pos[ax])>ROOM-0.6){st.pos[ax]=Math.sign(st.pos[ax])*(ROOM-0.6);st.vel[ax]*=-1;}
  }
  if(dInt<0.7){newInterest();}
  st.walk+=dt*speed*5.5;
  const targetH=Math.atan2(st.vel.x,st.vel.z);
  let dh=targetH-st.heading;dh=Math.atan2(Math.sin(dh),Math.cos(dh));st.heading+=dh*Math.min(1,dt*10);

  st.flinch=Math.max(0,st.flinch-dt*1.8);
  person.position.copy(st.pos);
  person.position.y=Math.abs(Math.sin(st.walk))*0.05+st.flinch*0.12;
  person.rotation.y=st.heading;
  const sw=Math.sin(st.walk)*0.7;
  armL.rotation.x=sw+st.flinch*1.6;armR.rotation.x=-sw+st.flinch*1.6;
  legL.rotation.x=-sw;legR.rotation.x=sw;
  head.position.y=1.72;head.rotation.z=Math.sin(now/90)*0.18*st.flinch;

  // Ebene folgt dem Kopf (Ausrichtung bleibt weltfest)
  planeRig.position.set(st.pos.x,2.55+Math.sin(now/700)*0.04,st.pos.z);

  // Marker
  markers.forEach((m,i)=>{
    const isSrc=i===st.src,isSnk=i===st.snk;
    const pulse=isSrc?1.5+0.5*Math.sin(now/90):(isSnk?1.2:1);
    m.scale.setScalar(pulse);
  });
  ring.position.set(cornerLocal[st.snk][0],cornerLocal[st.snk][1],0.03);
  ring.scale.setScalar(1+0.15*Math.sin(now/200)+(st.state==='hit'?st.t*1.2:0));
  ring.material.color.setHex(COLORS[st.snk]);

  // Interesse-Orb nimmt Farbe der Ebene an
  orb.position.copy(orbPos);orb.position.y+=Math.sin(now/500)*0.08;orb.rotation.y+=dt;orb.rotation.x+=dt*0.6;
  orb.material.color.setHex(COLORS[Math.round(U.uPhase.value)%4]);
  orbLbl.position.set(orbPos.x,orbPos.y+0.55,orbPos.z);

  // Ri-Relationen
  plane.updateWorldMatrix(true,false);
  const cs=cornerWorldXZ(st.src),cn=cornerWorldXZ(st.snk);
  const headW=new THREE.Vector3(st.pos.x,1.75,st.pos.z);
  const centerW=new THREE.Vector3(planeRig.position.x,planeRig.position.y,planeRig.position.z);
  const hit=st.state==='hit'?1:0;
  setLine(rel[0],cs,cn);rel[0].material.color.setHex(COLORS[st.src]);rel[0].material.opacity=st.state==='travel'?0.9:0.35;
  setLine(rel[1],cn,headW);rel[1].material.color.setHex(COLORS[st.snk]);rel[1].material.opacity=0.25+0.7*hit*Math.max(0,1-st.t/1.5);
  setLine(rel[2],headW,centerW);rel[2].material.color.setHex(COLORS[Math.round(U.uPhase.value)%4]);rel[2].material.opacity=0.5;
  setLine(rel[3],orbPos,headW);rel[3].material.color.setHex(0xffffff);rel[3].material.opacity=0.15+0.5*resonance;

  // Kamera
  if(!dragging)theta+=dt*0.06;
  const tgt=new THREE.Vector3(st.pos.x*0.6,1.6,st.pos.z*0.6);
  camera.position.set(tgt.x+rad*Math.sin(phi)*Math.sin(theta),tgt.y+rad*Math.cos(phi),tgt.z+rad*Math.sin(phi)*Math.cos(theta));
  camera.lookAt(tgt);

  // HUD
  $('route').textContent='Quelle '+NAMES[st.src]+' → Senke '+NAMES[st.snk];
  $('state').textContent=st.state==='travel'?'Vibration läuft zur Senke':st.state==='hit'?'Treffer an der Senke · Richtungswechsel':'Ruhe · Senke wird neue Quelle';
  for(let i=0;i<4;i++)$('c'+i).classList.toggle('on',i===st.src);
  $('interest').textContent='Abstand zu eigene_Interessen: '+dInt.toFixed(1)+' m · Treffer: '+st.count;
  const total=D/WSPEED+2.3+1.0;
  const el_=st.state==='travel'?st.t:st.state==='hit'?D/WSPEED+st.t:D/WSPEED+2.3+st.t;
  $('fill').style.width=Math.min(100,el_/total*100)+'%';
  $('fill').style.background='#'+COLORS[st.src].toString(16).padStart(6,'0');

  renderer.render(scene,camera);
  requestAnimationFrame(tick);
}
requestAnimationFrame(tick);
})();
</script>
</body>
</html>
