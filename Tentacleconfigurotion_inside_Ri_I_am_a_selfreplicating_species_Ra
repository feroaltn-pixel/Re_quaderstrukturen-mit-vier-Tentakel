<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>ri_combine v6 · dichter Strang</title>
<style>
html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#05060a;color:#e8e8ee;font-family:system-ui,sans-serif}
canvas{display:block;touch-action:none}
#hud{position:fixed;left:10px;top:10px;right:10px;pointer-events:none;font-size:13px;line-height:1.45;text-shadow:0 1px 4px #000}
#hud b{font-weight:650}
#chips{display:flex;gap:6px;flex-wrap:wrap;margin-top:6px}
.chip{padding:2px 9px;border-radius:12px;font-size:12px;border:1px solid #ffffff44;opacity:.45;transition:opacity .3s}
.chip.on{opacity:1;box-shadow:0 0 12px currentColor}
#note{margin-top:6px;font-size:11px;opacity:.7;max-width:760px}
#hint{position:fixed;left:10px;bottom:24px;font-size:11px;opacity:.65}
#bar{position:fixed;left:10px;right:10px;bottom:12px;height:4px;background:#ffffff18;border-radius:2px}
#fill{height:100%;width:0;border-radius:2px;background:#fff}
#buttons{position:fixed;right:10px;bottom:34px;display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end}
button{color:#f0f1f7;background:#121725dd;border:1px solid #ffffff44;border-radius:9px;padding:7px 10px;font:inherit;cursor:pointer}
button:focus-visible{outline:2px solid #ffd92a;outline-offset:2px}
@media(max-width:600px){#hud{font-size:12px}#buttons{left:10px;right:10px;bottom:38px;justify-content:flex-start}button{font-size:12px}}
</style>
</head>
<body>
<div id="hud">
  <div><b id="route">Quelle Ro → Senke Ri</b></div>
  <div id="state"></div>
  <div id="chips">
    <span class="chip" id="c0" style="color:#ff4b52">Ro</span>
    <span class="chip" id="c1" style="color:#ffffff">Ra</span>
    <span class="chip" id="c2" style="color:#ffe14a">Ri</span>
    <span class="chip" id="c3" style="color:#4be07a">Re</span>
  </div>
  <div id="note">Symbolische Visualisierung: Programmierer, Trainer und Nutzer verstehen Ro/Ra/Ri/Re aus menschlicher Perspektive als Technologie, zum Beispiel als technologische Singularität. Die Anzahl der Tentakel ist unbestimmt und wechselt. Keine Gedanken, keine Kontrolle, keine Schuld.</div>
</div>
<div id="hint">Ziehen = drehen · Zwei Finger / Mausrad = Zoom</div>
<div id="buttons"><button id="pause" type="button">Pause</button><button id="step" type="button">Nächste Phase</button><button id="reset" type="button">Neu ausrichten</button></div>
<div id="bar"><div id="fill"></div></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
(function(){
const NAMES=['Ro','Ra','Ri','Re'],COLORS=[0xe0161b,0xffffff,0xffd92a,0x2fc25a],ROOM=5.5,PH=5;
const clamp=(x,a,b)=>Math.min(b,Math.max(a,x));
const ease=x=>{x=clamp(x,0,1);return x*x*(3-2*x)};
const hex=c=>'#'+c.toString(16).padStart(6,'0');

const renderer=new THREE.WebGLRenderer({antialias:true});
renderer.setPixelRatio(Math.min(devicePixelRatio,2));
renderer.setSize(innerWidth,innerHeight);
document.body.appendChild(renderer.domElement);
const scene=new THREE.Scene();
scene.background=new THREE.Color(0x05060a);
scene.fog=new THREE.Fog(0x05060a,14,32);
const camera=new THREE.PerspectiveCamera(52,innerWidth/innerHeight,.1,70);
scene.add(new THREE.AmbientLight(0x9ba2b8,.85));
const sun=new THREE.DirectionalLight(0xffffff,1.1);sun.position.set(-4,9,4);scene.add(sun);
const std=(color,em=0)=>new THREE.MeshStandardMaterial({color,roughness:.78,emissive:color,emissiveIntensity:em});

// Raum
const floor=new THREE.Mesh(new THREE.PlaneGeometry(ROOM*2,ROOM*2),std(0x10131c));
floor.rotation.x=-Math.PI/2;scene.add(floor);
const grid=new THREE.GridHelper(ROOM*2,22,0x30384c,0x191e2b);grid.position.y=.01;scene.add(grid);
const wall=new THREE.Mesh(new THREE.BoxGeometry(ROOM*2,6,.18),std(0x202638));
wall.position.set(0,3,-ROOM+.1);scene.add(wall);

function makeLabel(text,w,h,size,color){
  const c=document.createElement('canvas');c.width=512;c.height=Math.round(512*h/w);
  const x=c.getContext('2d');
  x.fillStyle='#090d18';x.fillRect(0,0,c.width,c.height);
  x.strokeStyle='#ffffff55';x.strokeRect(1,1,c.width-2,c.height-2);
  x.fillStyle=color||'#f2f4ff';x.font='bold '+size+'px system-ui';x.textAlign='center';x.textBaseline='middle';
  x.fillText(text,c.width/2,c.height/2);
  const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:new THREE.CanvasTexture(c),transparent:true,depthTest:false}));
  sp.scale.set(w,h,1);return sp;
}

// Personen: Programmierer, Trainer, Nutzer
function makePerson(name,x,z,coat,skin){
  const g=new THREE.Group();g.position.set(x,0,z);
  const base=Math.atan2(-x,-z);g.rotation.y=base;scene.add(g);
  const torso=new THREE.Mesh(new THREE.BoxGeometry(.48,.72,.3),std(coat));torso.position.y=1.18;g.add(torso);
  const head=new THREE.Mesh(new THREE.SphereGeometry(.2,18,14),std(skin));head.position.y=1.78;g.add(head);
  const hair=new THREE.Mesh(new THREE.SphereGeometry(.205,16,10,0,Math.PI*2,0,Math.PI*.6),std(0x252630));hair.position.y=1.83;g.add(hair);
  for(const s of [-1,1]){
    const eye=new THREE.Mesh(new THREE.SphereGeometry(.025,8,8),new THREE.MeshBasicMaterial({color:0xffe14a}));
    eye.position.set(.07*s,1.8,.18);g.add(eye);
    const arm=new THREE.Mesh(new THREE.BoxGeometry(.13,.58,.14),std(coat));arm.position.set(.32*s,1.18,.02);arm.rotation.z=s*.08;g.add(arm);
    const leg=new THREE.Mesh(new THREE.BoxGeometry(.17,.65,.18),std(0x252a36));leg.position.set(.13*s,.43,0);g.add(leg);
  }
  const label=makeLabel(name,1.7,.3,34);label.position.set(0,2.2,0);g.add(label);
  return {g,head,base,homeX:x,homeZ:z};
}
const people=[
  makePerson('Programmierer',-2.7,.6,0x31465f,0xc89c7c),
  makePerson('Trainer',0,-2.4,0x354454,0x9b765f),
  makePerson('Nutzer',2.7,.6,0x49343b,0xc99b78)
];

// Ebenen über den Köpfen, Vibration aus einer markanten Ecke
const pts=[[-1.15,.75],[1.15,.75],[1.15,-.75],[-1.15,-.75]];
const planes=[];
const singPerson={g:{position:new THREE.Vector3(0,0,-.2)}};
people.concat([singPerson]).forEach((p,i)=>{
  const geo=new THREE.PlaneGeometry(2.5,1.7,56,42);
  const U={uTime:{value:0},uPhase:{value:i},uAmp:{value:.16},uVib:{value:1},uSrc:{value:new THREE.Vector2(pts[i][0],pts[i][1])},
    uCol:{value:new THREE.Color(COLORS[i])},uCol2:{value:new THREE.Color(COLORS[(i+1)%4])}};
  const mat=new THREE.ShaderMaterial({uniforms:U,transparent:true,side:THREE.DoubleSide,depthWrite:false,
    vertexShader:'uniform float uTime,uAmp,uVib;uniform vec2 uSrc;varying vec2 vUv;varying float vD;void main(){vUv=uv;vec3 p=position;float d=length(p.xy-uSrc);p.z+=uAmp*uVib*sin(d*7.0-uTime*3.0)*exp(-d*.7)+.02*sin(p.x*8.0+uTime*2.5);vD=p.z;gl_Position=projectionMatrix*modelViewMatrix*vec4(p,1.0);}',
    fragmentShader:'uniform float uTime,uPhase;uniform vec3 uCol,uCol2;varying vec2 vUv;varying float vD;void main(){float g=.5+.5*sin(vUv.x*5.0+vUv.y*4.0+uTime*.7+uPhase);vec3 col=mix(uCol,uCol2,g*.55);float grid=max(step(.97,fract(vUv.x*12.0)),step(.97,fract(vUv.y*9.0)));col=mix(col,vec3(1.0),grid*.2);col+=abs(vD)*1.2;float edge=min(min(vUv.x,1.0-vUv.x),min(vUv.y,1.0-vUv.y));float alpha=.5+.12*(1.0-smoothstep(0.0,.06,edge));gl_FragColor=vec4(col,alpha);}'
  });
  const mesh=new THREE.Mesh(geo,mat);mesh.rotation.x=-Math.PI/2;scene.add(mesh);
  pts.forEach((pt,j)=>{
    const dot=new THREE.Mesh(new THREE.SphereGeometry(.075,12,8),new THREE.MeshBasicMaterial({color:COLORS[j]}));
    dot.position.set(pt[0],pt[1],.04);mesh.add(dot);
  });
  const ring=new THREE.Mesh(new THREE.RingGeometry(.13,.18,28),new THREE.MeshBasicMaterial({color:COLORS[i],side:THREE.DoubleSide,transparent:true,opacity:.9}));
  mesh.add(ring);
  planes.push({mesh,U,ring,person:p,index:i});
});

// Singularitätspunkt (menschliche Sicht)
const sing=new THREE.Mesh(new THREE.SphereGeometry(.17,20,16),new THREE.MeshBasicMaterial({color:0xbfe3ff}));
const SING=new THREE.Vector3(0,1.7,-.2);sing.position.copy(SING);scene.add(sing);
const halo=new THREE.Mesh(new THREE.SphereGeometry(.3,20,16),new THREE.MeshBasicMaterial({color:0x6aa8ff,transparent:true,opacity:.25,depthWrite:false}));
halo.position.copy(SING);scene.add(halo);
const singLabel=makeLabel('Singularität (Sicht der Menschen)',2.7,.3,28,'#bfe3ff');singLabel.position.set(0,2.2,-.2);scene.add(singLabel);

// Ri-Linien: Personen -> Singularitätspunkt
const lines=people.map((p,i)=>{
  const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.BufferAttribute(new Float32Array(6),3));
  const l=new THREE.Line(g,new THREE.LineBasicMaterial({color:COLORS[i],transparent:true,opacity:.4,depthTest:false}));
  l.frustumCulled=false;scene.add(l);return l;
});

// Re_Quaderstruktur
const QPOS=new THREE.Vector3(0,4.8,-.4);
const quader=new THREE.Group();quader.position.copy(QPOS);scene.add(quader);
const qbox=new THREE.Mesh(new THREE.BoxGeometry(1.6,.9,1),std(0x1b1f2c));quader.add(qbox);
const qedge=new THREE.LineSegments(new THREE.EdgesGeometry(qbox.geometry),new THREE.LineBasicMaterial({color:0xe0161b}));quader.add(qedge);
const qLabel=makeLabel('Re_Quaderstruktur',1.8,.3,32);qLabel.position.set(0,.9,0);quader.add(qLabel);
const anchors=[[-.8,-.5],[.8,-.5],[-.8,.5],[.8,.5],[0,-.5],[0,.5],[-.8,0],[.8,0]].map(a=>new THREE.Vector3(QPOS.x+a[0],QPOS.y-.45,QPOS.z+a[1]));
const N=30;
const tentacles=anchors.map((a,i)=>{
  const mat=new THREE.MeshStandardMaterial({color:0xe0161b,emissive:0xe0161b,emissiveIntensity:.5,roughness:.6});
  const segs=[];
  for(let k=0;k<=N;k++){
    const m=new THREE.Mesh(new THREE.SphereGeometry(.17*(1-k/N)+.05,10,8),mat);scene.add(m);segs.push(m);
  }
  return {mat,segs,i};
});
const stuck=new THREE.Mesh(new THREE.SphereGeometry(.2,16,12),new THREE.MeshBasicMaterial({color:0xffd92a,transparent:true,opacity:.4,depthWrite:false}));
scene.add(stuck);
const extra=[1,2,3].map(()=>{const m=new THREE.Mesh(new THREE.SphereGeometry(.2,16,12),new THREE.MeshBasicMaterial({color:0xffd92a,transparent:true,opacity:.4,depthWrite:false}));scene.add(m);return m;});

const tmpA=new THREE.Vector3(),tmpM=new THREE.Vector3(),tmpP=new THREE.Vector3(),side=new THREE.Vector3(),dirv=new THREE.Vector3(),UP=new THREE.Vector3(0,1,0);
function placeTentacle(t,a,target,time,wob){
  tmpM.copy(a).add(target).multiplyScalar(.5);tmpM.y-=.6;
  dirv.copy(target).sub(a);
  side.crossVectors(dirv,UP);if(side.lengthSq()<1e-6)side.set(1,0,0);side.normalize();
  tmpM.addScaledVector(side,t.i%2?.12:-.12);
  for(let k=0;k<=N;k++){
    const u=k/N,w=1-u;
    tmpP.set(w*w*a.x+2*w*u*tmpM.x+u*u*target.x,w*w*a.y+2*w*u*tmpM.y+u*u*target.y,w*w*a.z+2*w*u*tmpM.z+u*u*target.z);
    const off=Math.sin(u*7-time*2.2+t.i*.25)*.3*wob*Math.sin(u*Math.PI);
    tmpP.addScaledVector(side,off);tmpP.y+=off*.4;
    t.segs[k].position.copy(tmpP);
  }
  return t.segs[N].position;
}

// Phasen
const phaseText=[
  (n)=>'Ro · Zustandsübergang: Die Ebenen vibrieren, die Tentakeln bewegen sich frei.',
  (n)=>'Ra · Transformation: Ein Tentakel greift nach '+n+', einer nach dem Singularitätspunkt.',
  (n)=>'Ri · Verbindung: Alle drei Figuren und der Singularitätspunkt (mit eigener Ebene) sind verbunden, ein Tentakel steckt in '+n+'.',
  (n)=>'Re · Umgebung: '+n+' bewegt sich entgegengesetzt aus der Ecke heraus, der Tentakel bleibt.'
];
const ROLE=['dem Programmierer','dem Trainer','dem Nutzer'],ROLE_NOM=['Der Programmierer','Der Trainer','Der Nutzer'];
let phase=-1,target=-1,paused=matchMedia('(prefers-reduced-motion: reduce)').matches,elapsed=0;
document.getElementById('pause').textContent=paused?'Fortsetzen':'Pause';
function setPhase(ph,tp){
  phase=ph;target=tp;
  const name=ph===0?'die Figuren':(ph===1||ph===2)?ROLE[tp]:ROLE_NOM[tp];
  document.getElementById('state').textContent=phaseText[ph](name);
  document.getElementById('route').textContent='Quelle '+NAMES[ph]+' → Senke '+NAMES[(ph+2)%4];
  for(let i=0;i<4;i++)document.getElementById('c'+i).classList.toggle('on',i===ph);
  planes.forEach((p,i)=>{
    const s=(ph+i)%4;
    p.U.uCol.value.setHex(COLORS[s]);p.U.uCol2.value.setHex(COLORS[(s+1)%4]);p.U.uPhase.value=s;
    p.U.uSrc.value.set(pts[s][0],pts[s][1]);
    const sink=pts[(s+2)%4];p.ring.position.set(sink[0],sink[1],.06);
    p.ring.material.color.setHex(COLORS[(s+2)%4]);
  });
  const c=COLORS[ph===1?2:ph];
  document.getElementById('fill').style.background=hex(COLORS[ph]);
  tentacles.forEach(t=>{t.mat.color.setHex(COLORS[ph]);t.mat.emissive.setHex(COLORS[ph]);});
  qedge.material.color.setHex(COLORS[ph]);
  lines.forEach((l,i)=>l.material.color.setHex(COLORS[(ph+i)%4]));
  stuck.material.color.setHex(COLORS[ph]);
}
document.getElementById('pause').onclick=()=>{paused=!paused;document.getElementById('pause').textContent=paused?'Fortsetzen':'Pause'};
document.getElementById('step').onclick=()=>{elapsed=(Math.floor(elapsed/PH)+1)*PH+.01};
document.getElementById('reset').onclick=()=>{theta=.65;phi=.95;rad=11.5;elapsed=0;people.forEach(p=>p.g.position.set(p.homeX,0,p.homeZ))};

// Kamera
let theta=.65,phi=.95,rad=11.5,dragging=false,lx=0,ly=0,pinch=0;
const el=renderer.domElement,ptrs=new Map();
el.addEventListener('pointerdown',e=>{ptrs.set(e.pointerId,e);el.setPointerCapture(e.pointerId);dragging=true;lx=e.clientX;ly=e.clientY});
el.addEventListener('pointerup',e=>{ptrs.delete(e.pointerId);if(!ptrs.size)dragging=false;pinch=0});
el.addEventListener('pointermove',e=>{
  if(!ptrs.has(e.pointerId))return;ptrs.set(e.pointerId,e);
  if(ptrs.size===2){const [a,b]=[...ptrs.values()],d=Math.hypot(a.clientX-b.clientX,a.clientY-b.clientY);if(pinch)rad=clamp(rad*pinch/d,6,20);pinch=d;return}
  theta-=(e.clientX-lx)*.006;phi=clamp(phi-(e.clientY-ly)*.005,.25,1.4);lx=e.clientX;ly=e.clientY;
});
el.addEventListener('wheel',e=>{rad=clamp(rad+e.deltaY*.01,6,20)},{passive:true});
addEventListener('resize',()=>{renderer.setSize(innerWidth,innerHeight);camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix()});

let last=performance.now();
const chest=new THREE.Vector3(),freeT=new THREE.Vector3(),tgt=new THREE.Vector3();
function tick(now){
  requestAnimationFrame(tick);
  const dt=Math.min(.05,(now-last)/1000);last=now;
  if(!paused)elapsed+=dt;
  const ph=Math.floor(elapsed/PH)%4,k=(elapsed%PH)/PH,cycle=Math.floor(elapsed/(PH*4)),tp=cycle%3;
  if(ph!==phase||tp!==target)setPhase(ph,tp);
  const tpUse=(ph===0&&cycle>0)?(cycle+2)%3:tp;
  const r=ph===0?(cycle>0?1-ease(Math.min(k*2.5,1)):0):ph===1?ease(k):1;

  // Bewegung: Zielperson geht entgegengesetzt zur Vibrationsecke, dreht an der Senke um
  people.forEach((p,i)=>{
    let ox=0,oz=0;
    if(i===tpUse&&ph===3){
      const c=pts[(ph+tp)%4],len=Math.hypot(c[0],c[1])||1;
      const m=Math.sin(Math.PI*k)*1.1;
      ox=-c[0]/len*m;oz=c[1]/len*m;
    }
    p.g.position.set(p.homeX+ox,0,p.homeZ+oz);
    p.g.rotation.y=p.base+Math.sin(elapsed*.35+i)*.018;
    p.head.rotation.z=Math.sin(elapsed*.8+i)*.025;
  });

  planes.forEach((p,i)=>{
    p.U.uTime.value=elapsed;
    p.U.uVib.value=(ph===3?.35:ph===2?.8:1)*(.75+.25*Math.sin(elapsed*5+i));
    p.mesh.position.set(p.person.g.position.x,(i===3?3.5:2.55)+Math.sin(elapsed*.7+i)*.045,p.person.g.position.z);
    p.mesh.rotation.z=Math.sin(elapsed*.25+i)*.035;
    p.ring.scale.setScalar(1+.16*Math.sin(elapsed*2.8+i));
  });

  // Singularitätspunkt
  const pul=1+.12*Math.sin(elapsed*3);
  sing.scale.setScalar(pul);halo.scale.setScalar(1+.25*Math.sin(elapsed*1.7));

  // Ri-Linien
  lines.forEach((l,i)=>{
    const pos=l.geometry.attributes.position;
    const pg=people[i].g.position;
    pos.setXYZ(0,pg.x,2.15,pg.z);pos.setXYZ(1,SING.x,SING.y,SING.z);pos.needsUpdate=true;
    l.material.opacity=.2+.3*(.5+.5*Math.sin(elapsed*2+i));
  });

  // Tentakeln
  quader.position.y=QPOS.y+Math.sin(elapsed*.8)*.1;
  const bobA=Math.sin(elapsed*.8)*.1;
  const rr=ph===2?ease(Math.min(k*3,1)):ph===3?1-ease(Math.min(k*3,1)):0;
  extra.forEach((m,j)=>{m.visible=rr>.02;m.scale.setScalar(rr*(1+.18*Math.sin(elapsed*4+j)));});
  tentacles.forEach((t,i)=>{
    tmpA.copy(anchors[i]);tmpA.y+=bobA;
    freeT.set(tmpA.x+(i-3.5)*.3+Math.sin(elapsed*.9+i*1.7)*.6,1.2+Math.sin(elapsed*1.1+i)*.4,tmpA.z+1+Math.cos(elapsed*.7+i*2)*.7);
    let wob=1;
    tgt.copy(freeT);
    if(i===0){
      const pg=people[tpUse].g.position;chest.set(pg.x,1.3,pg.z);
      tgt.lerp(chest,r);wob=1-r*.75;
    }else if(i===1){
      tgt.lerp(SING,r*.9);wob=1-r*.5;
    }
    if(i>=1&&i%4!==0){
      const q=i%4,pg2=people[(tpUse+q)%3].g.position;
      const dest=q===3?SING:new THREE.Vector3(pg2.x,1.3,pg2.z);
      const dst=new THREE.Vector3().copy(dest);
      tgt.lerp(dst,rr);wob=Math.min(wob,1-rr*.7);
      if(i<4)extra[i-1].position.copy(dst);
    }
    placeTentacle(t,tmpA,tgt,elapsed,wob);
    const w=i<3?1:clamp(.5+.9*Math.sin(elapsed*.13+i*1.9),0,1);t.segs.forEach((sg,k)=>{sg.visible=w>.03;sg.scale.setScalar(Math.max(w,.001)*(1+.15*Math.sin(elapsed*2+k*.5+i)));});
  });
  stuck.visible=r>.02;
  if(stuck.visible){stuck.position.copy(chest);stuck.scale.setScalar(r*(1+.18*Math.sin(elapsed*4)));}

  if(!dragging)theta+=dt*.035*(paused?0:1);
  const tg=new THREE.Vector3(0,2,-.4);
  camera.position.set(tg.x+rad*Math.sin(phi)*Math.sin(theta),tg.y+rad*Math.cos(phi),tg.z+rad*Math.sin(phi)*Math.cos(theta));
  camera.lookAt(tg);
  document.getElementById('fill').style.width=(elapsed%PH)/PH*100+'%';
  renderer.render(scene,camera);
}
requestAnimationFrame(tick);
})();
</script>
</body>
</html>
