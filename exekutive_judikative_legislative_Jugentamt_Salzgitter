    <script>
        async function generiereBewerbungPDF() {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF();

            // 1. Systemanker oben rechts in das PDF schreiben
            doc.setFont("courier", "bold");
            doc.setFontSize(12);
            doc.text("ro_ra_ri_re", 170, 15);

            // 2. Textinhalt auslesen
            const bewerbungsText = document.getElementById("bewerbungstext").innerText;

            // 3. Formatierung des Fließtextes für das PDF
            doc.setFont("helvetica", "normal");
            doc.setFontSize(11);
            
            // Text automatisch umbrechen lassen, damit er auf die Seite passt
            const textLinien = doc.splitTextToSize(bewerbungsText, 180);
            doc.text(textLinien, 15, 30);

            // PDF unter dem passenden Namen abspeichern
            doc.save("Bewerbung_Telefonseelsorge_Systemmodell.pdf");
        }
    </script>

